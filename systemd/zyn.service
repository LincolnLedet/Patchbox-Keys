[Unit]
Description=ZynAddSubFX (strings/pads/synth)
After=jack.service
BindsTo=jack.service

[Service]
User=patch
Group=patch
Environment=JACK_PROMISCUOUS_SERVER=jack
ExecStart=/usr/local/bin/zyn-start.sh
ExecStartPost=/bin/sh -c 'sleep 6; jack_connect zynaddsubfx:out_1 system:playback_1 2>/dev/null || true; jack_connect zynaddsubfx:out_2 system:playback_2 2>/dev/null || true; exit 0'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
